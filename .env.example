# ===== 部署：cp .env.example .env 即可启动（生产环境建议修改密钥）=====

# JWT 配置（必填）
JWT_SECRET_KEY=1f92e28bdda5b57062bffbc1c9742d7e0a1dd3adedab7df7b1ea50613549fe9c
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# AI 配置（考试答题用，可选）
DEEPSEEK_API_KEY=

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库配置（默认 SQLite 开箱即用；生产建议 MySQL）
DATABASE_URL=sqlite:///data/orders.db
# MySQL 备选（先手动建库: CREATE DATABASE anticheat DEFAULT CHARACTER SET utf8mb4;）:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/anticheat?charset=utf8mb4

# Redis 配置（可选，不装自动降级内存模式）
REDIS_URL=redis://localhost:6379/0

# 站点地址（支付回调用，部署后改成你的域名）
SITE_URL=http://localhost:8000

# 密码加密密钥（必填）
PASSWORD_ENCRYPTION_KEY=d3bcc01ff0dddd70f3e97652fb064c2d86b2458bd152b064

# 验证码服务配置（可选，默认使用内置值）
CAPTCHA_AK=
CAPTCHA_URL=

# 速率限制
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=600

# CORS
CORS_ORIGINS=*
