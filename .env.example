# ===== 部署：cp .env.example .env 即可启动（生产环境建议修改密钥）=====

# JWT 配置（必填）
JWT_SECRET_KEY=1f92e28bdda5b57062bffbc1c9742d7e0a1dd3adedab7df7b1ea50613549fe9c
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# AI 配置（考试答题用，可选）
DEEPSEEK_API_KEY=

# 服务器配置
HOST=0.0.0.0
PORT=8000
DEBUG=false

# 数据库（SQLite，唯一存储）
DB_PATH=data/orders.db

# 站点地址（支付回调用，部署后改成你的域名）
SITE_URL=http://localhost:8000

# Rust 刷课守护进程（内存优化：单进程多并发，不可达时自动回退 Python 子进程）
RUST_DAEMON_URL=http://127.0.0.1:17017

# OCR sidecar 服务（验证码识别独立进程，部署 ocr-sidecar.service）
OCR_SERVICE_URL=http://127.0.0.1:17018

# 阶段拆分（内存优化）：学校任务爬取后子进程退出，学习完成后再起考试子进程；
# 学习期（数小时）无 Python 子进程空转。出问题可置 false 回退完整流程。
WORKER_PHASE_SPLIT=true

# fork-COW 进程池（仅 Linux）：预热 master 进程 fork 出任务子进程，
# 共享内存页使每任务从 ~100MB 降到 ~35MB。需部署 worker-pool-master.service。
WORKER_POOL_ENABLED=false
WORKER_POOL_PORT=17019

# Worker 进度推送凭证（可选；设置后 /api/progress/live/push 校验 X-Worker-Token）
WORKER_TOKEN=change-me-worker-token

# 验证码服务配置（可选，默认使用内置值）
CAPTCHA_AK=
CAPTCHA_URL=

# 速率限制
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=600

# CORS
CORS_ORIGINS=*
