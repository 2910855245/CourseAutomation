# ===== 部署：cp .env.example .env 即可启动（生产环境建议修改密钥）=====

# JWT 配置（必填）
JWT_SECRET_KEY=1f92e28bdda5b57062bffbc1c9742d7e0a1dd3adedab7df7b1ea50613549fe9c
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# AI 配置（考试答题用，可选）
DEEPSEEK_API_KEY=

# Rust 后端监听端口（单一后端：API + 前端静态页 + OCR + 刷课 daemon）
RUST_DAEMON_PORT=17017

# 数据库（SQLite，唯一存储，建表由 Rust schema.rs 启动时自动保证）
DB_PATH=data/orders.db

# 站点对外地址（支付回调用，部署后改成你的域名或 http://localhost:17017）
SITE_URL=http://localhost:17017

# Worker 进度推送凭证（可选；设置后 /api/progress/live/push 校验 X-Worker-Token）
WORKER_TOKEN=change-me-worker-token

# 验证码服务配置（可选，默认使用内置值）
CAPTCHA_AK=
CAPTCHA_URL=

# 速率限制（按客户端 IP 计数，超限返回 429 + Retry-After）
# RATE_LIMIT_REQUESTS 为普通接口阈值；敏感接口（登录/扫描/下单/支付/答题）
# 另有一套更严的阈值，默认取前者的 1/10 并夹在 10~60 之间。
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REQUESTS=600
# RATE_LIMIT_SENSITIVE=60
# RATE_LIMIT_ENABLED=true
# 是否采信 X-Forwarded-For 判断真实访客 IP。
# 默认只信任来自回环地址的 XFF（即同机反向代理）；代理在别的机器上时，
# 要么置 false（全体访客共用一个桶），要么在代理上补 X-Real-IP。
# RATE_LIMIT_TRUST_PROXY=true

# 管理员登录失败封锁（防暴力破解，按账号维度）
# ADMIN_LOGIN_MAX_FAILS=5
# ADMIN_LOGIN_LOCK_SECONDS=900

# 自定义 CSP（默认策略见 rust_worker/src/guard.rs，一般不需要改）
# CSP_POLICY=default-src 'self'; script-src 'self' 'unsafe-inline'; ...

# CORS（当前后端未启用 CORS 层，前端与 API 同源部署，保持默认即可）
CORS_ORIGINS=*

# Rust 队列调度（内置刷课队列，true 开启）
RUST_QUEUE_ENABLED=true
# RUST_QUEUE_MAX_WORKERS=8

# 学员凭据加密主密钥（AES-256-GCM，可选但强烈建议生产环境显式设置）
# 64 位 hex（32 字节）。未设置时依次回退：PASSWORD_ENCRYPTION_KEY → JWT_SECRET_KEY 派生。
# 注意：解密会按上述顺序逐个尝试，所以补配/轮换密钥不会导致历史密文失效。
# 生成方式：openssl rand -hex 32
# CREDENTIAL_KEY=
