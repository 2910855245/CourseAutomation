[Unit]
Description=OCR Sidecar (ddddocr)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/anti-course
ExecStart=/opt/anti-course/venv/bin/uvicorn ocr_sidecar:app --host 127.0.0.1 --port 17018
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
