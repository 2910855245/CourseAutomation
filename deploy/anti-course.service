[Unit]
Description=Anti-Course Automation Platform
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/anti-course
ExecStart=/opt/anti-course/venv/bin/granian --interface asgi --host 0.0.0.0 --port 8000 run:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
